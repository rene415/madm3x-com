---
import { listGalleries, listPhotos, photoUrl } from '../../../../lib/galleries.ts';

const galleries = await listGalleries();

// Grab first photo of each gallery for cover art
const covers: Record<string, string | null> = {};
for (const g of galleries) {
  const photos = await listPhotos(g.slug);
  covers[g.slug] = photos.length > 0 ? photoUrl(g.slug, photos[0]) : null;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MADM3X · Dashboard</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: #080808; color: #e8e8e8; font-family: 'Courier New', monospace; min-height: 100vh; }
    a { color: inherit; text-decoration: none; }

    /* header */
    .header { display: flex; align-items: center; justify-content: space-between;
      padding: 18px 28px; border-bottom: 1px solid rgba(255,255,255,0.07); position: sticky; top: 0;
      background: #080808; z-index: 10; }
    .header-logo { display: flex; align-items: center; gap: 12px; }
    .header-logo img { width: 36px; }
    .header-logo span { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.2em;
      color: rgba(255,255,255,0.4); }
    .btn { display: inline-flex; align-items: center; gap: 6px; background: #fff; color: #080808;
      border: none; border-radius: 6px; padding: 8px 16px; font-family: inherit; font-size: 0.7rem;
      text-transform: uppercase; letter-spacing: 0.12em; cursor: pointer; font-weight: 700;
      transition: opacity 0.2s; }
    .btn:hover { opacity: 0.85; }
    .btn-ghost { background: transparent; color: rgba(255,255,255,0.45); border: 1px solid rgba(255,255,255,0.12); }
    .btn-ghost:hover { color: #fff; border-color: rgba(255,255,255,0.3); opacity: 1; }

    /* main */
    .main { max-width: 1100px; margin: 0 auto; padding: 36px 28px 80px; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
    .section-title { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.18em;
      color: rgba(255,255,255,0.35); }

    /* gallery grid */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }

    .card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px; overflow: hidden; cursor: pointer; transition: border-color 0.25s, transform 0.25s; }
    .card:hover { border-color: rgba(255,255,255,0.2); transform: translateY(-2px); }
    .card-cover { aspect-ratio: 4/3; background: rgba(255,255,255,0.04); overflow: hidden; position: relative; }
    .card-cover img { width: 100%; height: 100%; object-fit: cover; }
    .card-cover-empty { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 2rem; opacity: 0.15; }
    .card-body { padding: 14px 16px; }
    .card-title { font-size: 0.85rem; font-weight: 700; margin-bottom: 8px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-meta { display: flex; align-items: center; justify-content: space-between; }
    .card-count { font-size: 0.6rem; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.1em; }
    .badge { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.1em;
      padding: 3px 8px; border-radius: 99px; }
    .badge-live  { background: rgba(74, 222, 128, 0.15); color: #4ade80; border: 1px solid rgba(74,222,128,0.25); }
    .badge-draft { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.35); border: 1px solid rgba(255,255,255,0.1); }

    /* empty state */
    .empty { text-align: center; padding: 80px 20px; color: rgba(255,255,255,0.2); }
    .empty p { font-size: 0.75rem; margin-top: 8px; }

    /* modal */
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 50;
      align-items: center; justify-content: center; }
    .overlay.open { display: flex; }
    .modal { background: #111; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px;
      padding: 32px; width: 100%; max-width: 400px; margin: 16px; }
    .modal h2 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em;
      color: rgba(255,255,255,0.5); margin-bottom: 24px; }
    .field { margin-bottom: 18px; }
    label { display: block; font-size: 0.6rem; text-transform: uppercase;
      letter-spacing: 0.12em; color: rgba(255,255,255,0.35); margin-bottom: 6px; }
    input { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 6px; padding: 10px 12px; color: #fff; font-family: inherit;
      font-size: 0.85rem; outline: none; transition: border-color 0.2s; }
    input:focus { border-color: rgba(255,255,255,0.35); }
    .slug-hint { font-size: 0.58rem; color: rgba(255,255,255,0.25); margin-top: 5px; }
    .modal-actions { display: flex; gap: 10px; margin-top: 8px; }
    .modal-actions .btn { flex: 1; justify-content: center; }
    .error-msg { color: #ff6b6b; font-size: 0.65rem; margin-top: 10px; display: none; }
  </style>
</head>
<body>
  <header class="header">
    <div class="header-logo">
      <a href="/"><img src="/logo/logo-color.png" alt="MADM3X" /></a>
      <span>Admin</span>
    </div>
    <a href="/mad/3x/admin/logout" class="btn btn-ghost">Sign out</a>
  </header>

  <main class="main">
    <div class="section-header">
      <span class="section-title">Galleries — {galleries.length}</span>
      <button class="btn" id="new-btn">+ New Gallery</button>
    </div>

    {galleries.length === 0 ? (
      <div class="empty">
        <div style="font-size:3rem">📷</div>
        <p>No galleries yet. Create your first one.</p>
      </div>
    ) : (
      <div class="grid">
        {galleries.map(g => (
          <a href={`/mad/3x/admin/gallery/${g.slug}`} class="card">
            <div class="card-cover">
              {covers[g.slug]
                ? <img src={covers[g.slug]!} alt="" loading="lazy" />
                : <div class="card-cover-empty">🖼</div>
              }
            </div>
            <div class="card-body">
              <div class="card-title">{g.title}</div>
              <div class="card-meta">
                <span class="card-count">{g.slug}</span>
                <span class={`badge ${g.published ? 'badge-live' : 'badge-draft'}`}>
                  {g.published ? 'Live' : 'Draft'}
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>

  <!-- New gallery modal -->
  <div class="overlay" id="overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <h2 id="modal-title">New Gallery</h2>
      <div class="field">
        <label for="title">Title</label>
        <input type="text" id="title" placeholder="Yosemite 2026" autocomplete="off" />
      </div>
      <div class="field">
        <label for="slug">URL Slug</label>
        <input type="text" id="slug" placeholder="yosemite-2026" autocomplete="off" />
        <div class="slug-hint">madm3x.com/<span id="slug-preview">yosemite-2026</span></div>
      </div>
      <p class="error-msg" id="modal-error"></p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-btn">Cancel</button>
        <button class="btn" id="create-btn">Create</button>
      </div>
    </div>
  </div>

  <script>
    const overlay   = document.getElementById('overlay');
    const titleEl   = document.getElementById('title') as HTMLInputElement;
    const slugEl    = document.getElementById('slug') as HTMLInputElement;
    const preview   = document.getElementById('slug-preview');
    const errorEl   = document.getElementById('modal-error') as HTMLElement;
    const createBtn = document.getElementById('create-btn');

    document.getElementById('new-btn')?.addEventListener('click', () => {
      titleEl.value = ''; slugEl.value = ''; preview!.textContent = '';
      errorEl.style.display = 'none';
      overlay?.classList.add('open');
      titleEl.focus();
    });

    document.getElementById('cancel-btn')?.addEventListener('click', () => {
      overlay?.classList.remove('open');
    });

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.classList.remove('open');
    });

    // Auto-generate slug from title
    titleEl?.addEventListener('input', () => {
      const auto = titleEl.value.toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-');
      slugEl.value = auto;
      preview!.textContent = auto || '…';
    });

    slugEl?.addEventListener('input', () => {
      preview!.textContent = slugEl.value || '…';
    });

    createBtn?.addEventListener('click', async () => {
      const title = titleEl.value.trim();
      const slug  = slugEl.value.trim();
      if (!title || !slug) { showError('Both fields are required.'); return; }

      createBtn.textContent = 'Creating…';
      (createBtn as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('/api/gallery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, slug }),
        });
        const data = await res.json();
        if (!res.ok) { showError(data.error ?? 'Something went wrong'); return; }
        window.location.href = `/mad/3x/admin/gallery/${data.slug}`;
      } catch {
        showError('Network error — please try again.');
      } finally {
        createBtn.textContent = 'Create';
        (createBtn as HTMLButtonElement).disabled = false;
      }
    });

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
    }
  </script>
</body>
</html>
