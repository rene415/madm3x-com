---
import { getGallery, listPhotos, getMetadata, photoUrl, getGalleryStorageBytes, formatBytes } from '../../../../../lib/galleries.ts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/mad/3x/admin/dashboard');

const gallery = await getGallery(slug);
if (!gallery) return Astro.redirect('/mad/3x/admin/dashboard');

const photos      = await listPhotos(slug);
const metadata    = await getMetadata(slug);
const storageBytes = await getGalleryStorageBytes(slug);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MADM3X · {gallery.title}</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png" />
  <!-- is:global so dynamically JS-created .photo-card elements also get these styles -->
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: #080808; color: #e8e8e8; font-family: 'Courier New', monospace; min-height: 100vh; }
    a { color: inherit; text-decoration: none; }

    /* header */
    .header { display: flex; align-items: center; justify-content: space-between;
      padding: 18px 28px; border-bottom: 1px solid rgba(255,255,255,0.07);
      position: sticky; top: 0; background: #080808; z-index: 10; }
    .breadcrumb { display: flex; align-items: center; gap: 10px; }
    .breadcrumb img { width: 36px; }
    .breadcrumb-sep { color: rgba(255,255,255,0.15); }
    .breadcrumb-link { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em;
      color: rgba(255,255,255,0.35); transition: color 0.2s; }
    .breadcrumb-link:hover { color: rgba(255,255,255,0.7); }
    .btn { display: inline-flex; align-items: center; gap: 6px; background: #fff; color: #080808;
      border: none; border-radius: 6px; padding: 8px 16px; font-family: inherit; font-size: 0.7rem;
      text-transform: uppercase; letter-spacing: 0.12em; cursor: pointer; font-weight: 700; transition: opacity 0.2s; }
    .btn:hover { opacity: 0.85; }
    .btn-ghost { background: transparent; color: rgba(255,255,255,0.45); border: 1px solid rgba(255,255,255,0.12); }
    .btn-ghost:hover { color: #fff; border-color: rgba(255,255,255,0.3); opacity: 1; }
    .btn-danger { background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); }
    .btn-danger:hover { background: rgba(239,68,68,0.25); opacity: 1; }

    /* main */
    .main { max-width: 1100px; margin: 0 auto; padding: 36px 28px 100px; }

    /* meta bar */
    .meta-bar { display: flex; align-items: flex-start; justify-content: space-between;
      gap: 20px; margin-bottom: 36px; flex-wrap: wrap; }
    .gallery-title-wrap { flex: 1; min-width: 200px; }
    .gallery-title { font-size: 1.6rem; font-weight: 700; cursor: pointer;
      border-bottom: 1px solid transparent; transition: border-color 0.2s; display: inline-block; }
    .gallery-title:hover { border-color: rgba(255,255,255,0.3); }
    .gallery-slug { font-size: 0.62rem; color: rgba(255,255,255,0.3); text-transform: uppercase;
      letter-spacing: 0.12em; margin-top: 6px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .gallery-slug a { color: rgba(255,255,255,0.5); text-decoration: underline; text-underline-offset: 3px; }
    .draft-badge { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.3);
      border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-size: 0.55rem;
      padding: 2px 6px; text-transform: uppercase; letter-spacing: 0.1em; }
    .storage-info { font-size: 0.6rem; color: rgba(255,255,255,0.25); text-transform: uppercase;
      letter-spacing: 0.1em; margin-top: 4px; }

    /* publish toggle */
    .publish-wrap { display: flex; align-items: center; gap: 14px; padding: 14px 20px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; }
    .toggle-label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; }
    .toggle-label.live  { color: #4ade80; }
    .toggle-label.draft { color: rgba(255,255,255,0.35); }
    .toggle { position: relative; width: 44px; height: 24px; cursor: pointer; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle-track { position: absolute; inset: 0; background: rgba(255,255,255,0.12);
      border-radius: 99px; transition: background 0.25s; }
    .toggle input:checked + .toggle-track { background: #4ade80; }
    .toggle-thumb { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px;
      background: #fff; border-radius: 50%; transition: transform 0.25s; }
    .toggle input:checked ~ .toggle-thumb { transform: translateX(20px); }
    .view-link { font-size: 0.65rem; color: rgba(255,255,255,0.35); text-transform: uppercase;
      letter-spacing: 0.1em; text-decoration: underline; text-underline-offset: 3px; }

    /* section label */
    .section-label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.18em;
      color: rgba(255,255,255,0.25); margin-bottom: 14px; }

    /* drop zone */
    .drop-zone { border: 2px dashed rgba(255,255,255,0.15); border-radius: 12px;
      padding: 48px 24px; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s;
      margin-bottom: 6px; }
    .drop-zone:hover, .drop-zone.drag-over { border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.03); }
    .drop-icon { font-size: 2.5rem; margin-bottom: 10px; }
    .drop-main { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-bottom: 4px; }
    .drop-sub  { font-size: 0.65rem; color: rgba(255,255,255,0.25); }
    .upload-note { font-size: 0.6rem; color: rgba(255,255,255,0.2); text-align: center;
      margin-bottom: 20px; letter-spacing: 0.05em; }

    /* upload queue */
    .queue { margin-bottom: 32px; display: none; }
    .queue.visible { display: block; }
    .queue-item { display: flex; align-items: center; gap: 12px; padding: 8px 14px;
      background: rgba(255,255,255,0.04); border-radius: 6px; margin-bottom: 6px; font-size: 0.72rem; }
    .queue-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      color: rgba(255,255,255,0.6); }
    .queue-status { font-size: 0.68rem; white-space: nowrap; }
    .queue-status.uploading { color: rgba(255,255,255,0.35); }
    .queue-status.done    { color: #4ade80; }
    .queue-status.failed  { color: #ef4444; }

    /* photo grid — using CSS Grid so dynamically added cards are constrained immediately */
    .photo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; align-items: start; }
    @media (max-width: 900px) { .photo-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 600px) { .photo-grid { grid-template-columns: repeat(2, 1fr); } }

    /* photo card — is:global ensures these apply to JS-created cards too */
    .photo-card { position: relative; border-radius: 6px; overflow: hidden; }
    .photo-card img { width: 100%; height: auto; display: block; }
    .photo-del { position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.7);
      border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer;
      color: #fff; font-size: 0.9rem; display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.2s; }
    .photo-card:hover .photo-del { opacity: 1; }

    /* empty photos */
    .photos-empty { text-align: center; padding: 48px; color: rgba(255,255,255,0.15);
      border: 1px dashed rgba(255,255,255,0.08); border-radius: 10px; font-size: 0.75rem;
      grid-column: 1 / -1; }

    /* danger zone */
    .danger { margin-top: 64px; padding-top: 24px; border-top: 1px solid rgba(239,68,68,0.12); }
    .danger h3 { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.15em;
      color: rgba(239,68,68,0.5); margin-bottom: 14px; }
    .danger p { font-size: 0.72rem; color: rgba(255,255,255,0.3); margin-bottom: 14px; }

    /* rename modal */
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 50;
      align-items: center; justify-content: center; }
    .overlay.open { display: flex; }
    .modal { background: #111; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px;
      padding: 32px; width: 100%; max-width: 380px; margin: 16px; }
    .modal h2 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em;
      color: rgba(255,255,255,0.4); margin-bottom: 20px; }
    .modal label { display: block; font-size: 0.6rem; text-transform: uppercase;
      letter-spacing: 0.1em; color: rgba(255,255,255,0.3); margin-bottom: 6px; }
    .modal input { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 6px; padding: 10px 12px; color: #fff; font-family: inherit;
      font-size: 0.85rem; outline: none; }
    .modal input:focus { border-color: rgba(255,255,255,0.35); }
    .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
    .modal-actions .btn { flex: 1; justify-content: center; }
  </style>
</head>
<body>
  <header class="header">
    <div class="breadcrumb">
      <a href="/"><img src="/logo/logo-color.png" alt="MADM3X" /></a>
      <span class="breadcrumb-sep">/</span>
      <a href="/mad/3x/admin/dashboard" class="breadcrumb-link">Galleries</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-link" style="color:rgba(255,255,255,0.7)">{gallery.title}</span>
    </div>
    <a href="/mad/3x/admin/logout" class="btn btn-ghost">Sign out</a>
  </header>

  <main class="main">
    <!-- ── meta bar ── -->
    <div class="meta-bar">
      <div class="gallery-title-wrap">
        <div class="gallery-title" id="title-display" title="Click to rename">{gallery.title}</div>
        <div class="gallery-slug">
          <span>madm3x.com/</span>
          {gallery.published
            ? <a href={`/${gallery.slug}`} target="_blank">{gallery.slug} ↗</a>
            : <span>{gallery.slug}</span>
          }
          {!gallery.published && <span class="draft-badge">Not public</span>}
          <span>·</span>
          <span>{photos.length} photo{photos.length !== 1 ? 's' : ''}</span>
        </div>
        {storageBytes > 0 && (
          <div class="storage-info">💾 {formatBytes(storageBytes)} stored</div>
        )}
      </div>

      <div class="publish-wrap">
        <span id="pub-label" class={`toggle-label ${gallery.published ? 'live' : 'draft'}`}>
          {gallery.published ? 'Live' : 'Draft'}
        </span>
        <label class="toggle" title="Toggle publish">
          <input type="checkbox" id="pub-toggle" checked={gallery.published} />
          <div class="toggle-track"></div>
          <div class="toggle-thumb"></div>
        </label>
        {gallery.published && (
          <a href={`/${gallery.slug}`} target="_blank" class="view-link">View ↗</a>
        )}
      </div>
    </div>

    <!-- ── upload ── -->
    <p class="section-label">Add Photos</p>
    <div class="drop-zone" id="drop-zone">
      <div class="drop-icon">📁</div>
      <p class="drop-main">Drop photos here or <u>click to browse</u></p>
      <p class="drop-sub">JPEG · HEIC · PNG · TIFF → converted to WebP automatically</p>
      <input type="file" id="file-input" multiple accept=".jpg,.jpeg,.heic,.heif,.png,.tif,.tiff,.webp" hidden />
    </div>
    <p class="upload-note">Originals are not stored — only the converted WebP is saved to the server.</p>

    <div class="queue" id="queue"></div>

    <!-- ── photo grid ── -->
    <p class="section-label" style="margin-top: 32px">
      Photos — <span id="photo-count">{photos.length}</span>
    </p>

    <div class="photo-grid" id="photo-grid">
      {photos.length === 0 ? (
        <div class="photos-empty" id="photos-empty">No photos yet — upload some above.</div>
      ) : (
        photos.map(filename => (
          <div class="photo-card" data-filename={filename}>
            <img src={photoUrl(slug!, filename)} alt="" loading="lazy" />
            <button class="photo-del" title="Delete photo" data-filename={filename}>✕</button>
          </div>
        ))
      )}
    </div>

    <!-- ── danger zone ── -->
    <div class="danger">
      <h3>Danger Zone</h3>
      <p>Deleting a gallery permanently removes all its photos and cannot be undone.</p>
      <button class="btn btn-danger" id="delete-gallery-btn">Delete Gallery</button>
    </div>
  </main>

  <!-- Rename modal -->
  <div class="overlay" id="rename-overlay">
    <div class="modal">
      <h2>Rename Gallery</h2>
      <label for="rename-input">Title</label>
      <input type="text" id="rename-input" value={gallery.title} />
      <div class="modal-actions">
        <button class="btn btn-ghost" id="rename-cancel">Cancel</button>
        <button class="btn" id="rename-save">Save</button>
      </div>
    </div>
  </div>

  <script define:vars={{ gallerySlug: slug, initialPublished: gallery.published }}>
    // ── publish toggle ─────────────────────────────────────────────────────
    const pubToggle = document.getElementById('pub-toggle');
    const pubLabel  = document.getElementById('pub-label');

    pubToggle?.addEventListener('change', async () => {
      const published = pubToggle.checked;
      try {
        const res = await fetch(`/api/gallery/${gallerySlug}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ published }),
        });
        if (res.ok) {
          pubLabel.textContent = published ? 'Live' : 'Draft';
          pubLabel.className   = `toggle-label ${published ? 'live' : 'draft'}`;
          // reload to update the URL link / draft badge without requiring a full repage
          window.location.reload();
        } else {
          pubToggle.checked = !published; // revert
        }
      } catch {
        pubToggle.checked = !published;
      }
    });

    // ── rename ─────────────────────────────────────────────────────────────
    const overlay      = document.getElementById('rename-overlay');
    const titleDisplay = document.getElementById('title-display');
    const renameInput  = document.getElementById('rename-input');

    titleDisplay?.addEventListener('click', () => {
      renameInput.value = titleDisplay.textContent.trim();
      overlay?.classList.add('open');
      renameInput.focus();
      renameInput.select();
    });

    document.getElementById('rename-cancel')?.addEventListener('click', () => {
      overlay?.classList.remove('open');
    });

    document.getElementById('rename-save')?.addEventListener('click', async () => {
      const title = renameInput.value.trim();
      if (!title) return;
      const res = await fetch(`/api/gallery/${gallerySlug}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title }),
      });
      if (res.ok) {
        titleDisplay.textContent = title;
        document.title = `MADM3X · ${title}`;
        overlay?.classList.remove('open');
      }
    });

    overlay?.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('open'); });
    renameInput?.addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('rename-save')?.click(); });

    // ── upload ─────────────────────────────────────────────────────────────
    const dropZone  = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const queue     = document.getElementById('queue');
    let photoCount  = parseInt(document.getElementById('photo-count')?.textContent ?? '0', 10);

    dropZone?.addEventListener('click', () => fileInput?.click());

    dropZone?.addEventListener('dragover', e => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });
    dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));

    dropZone?.addEventListener('drop', e => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      const files = [...(e.dataTransfer?.files ?? [])];
      if (files.length) handleFiles(files);
    });

    fileInput?.addEventListener('change', () => {
      const files = [...(fileInput.files ?? [])];
      if (files.length) { handleFiles(files); fileInput.value = ''; }
    });

    function handleFiles(files) {
      queue?.classList.add('visible');
      // Upload sequentially to avoid overwhelming the server
      let chain = Promise.resolve();
      for (const file of files) {
        chain = chain.then(() => uploadFile(file));
      }
    }

    function addQueueItem(file) {
      const el = document.createElement('div');
      el.className = 'queue-item';
      el.dataset.qfile = file.name;
      el.innerHTML = `
        <span class="queue-name">${file.name}</span>
        <span class="queue-status uploading">Uploading…</span>
      `;
      queue?.appendChild(el);
      return el;
    }

    async function uploadFile(file) {
      const item   = addQueueItem(file);
      const status = item.querySelector('.queue-status');
      const form   = new FormData();
      form.append('file', file);

      try {
        const res  = await fetch(`/api/upload/${gallerySlug}`, { method: 'POST', body: form });
        const data = await res.json();

        if (res.ok) {
          status.textContent = '✓ Done';
          status.className   = 'queue-status done';
          addPhotoCard(data.filename, data.src);
        } else {
          status.textContent = `✗ ${data.error ?? 'Failed'}`;
          status.className   = 'queue-status failed';
        }
      } catch {
        status.textContent = '✗ Network error';
        status.className   = 'queue-status failed';
      }
    }

    function addPhotoCard(filename, src) {
      document.getElementById('photos-empty')?.remove();

      photoCount++;
      document.getElementById('photo-count').textContent = String(photoCount);

      // Build the card with DOM methods so styles apply correctly
      // (innerHTML-created elements miss Astro's scoped CSS attribute,
      //  but is:global on the <style> block means this is no longer an issue)
      const card = document.createElement('div');
      card.className = 'photo-card';
      card.dataset.filename = filename;

      const img = document.createElement('img');
      img.src = src;
      img.alt = '';
      img.loading = 'lazy';

      const btn = document.createElement('button');
      btn.className = 'photo-del';
      btn.dataset.filename = filename;
      btn.title = 'Delete photo';
      btn.textContent = '✕';
      btn.addEventListener('click', handleDeletePhoto);

      card.appendChild(img);
      card.appendChild(btn);
      document.getElementById('photo-grid')?.prepend(card);
    }

    // ── delete photo ───────────────────────────────────────────────────────
    document.getElementById('photo-grid')?.addEventListener('click', e => {
      const btn = e.target.closest('.photo-del');
      if (btn) handleDeletePhoto.call(btn, e);
    });

    async function handleDeletePhoto(e) {
      e.stopPropagation();
      const filename = this.dataset.filename;
      if (!filename) return;
      if (!confirm(`Delete ${filename}?`)) return;

      const res = await fetch(`/api/photo/${gallerySlug}/${encodeURIComponent(filename)}`, { method: 'DELETE' });
      if (res.ok) {
        const card = document.querySelector(`.photo-card[data-filename="${filename}"]`);
        card?.remove();
        photoCount--;
        document.getElementById('photo-count').textContent = String(photoCount);
        if (photoCount === 0) {
          const grid = document.getElementById('photo-grid');
          const empty = document.createElement('div');
          empty.id = 'photos-empty';
          empty.className = 'photos-empty';
          empty.textContent = 'No photos yet — upload some above.';
          grid?.appendChild(empty);
        }
      }
    }

    // ── delete gallery ─────────────────────────────────────────────────────
    document.getElementById('delete-gallery-btn')?.addEventListener('click', async () => {
      if (!confirm(`Delete the entire "${gallerySlug}" gallery and all its photos? This cannot be undone.`)) return;
      const res = await fetch(`/api/gallery/${gallerySlug}`, { method: 'DELETE' });
      if (res.ok) window.location.href = '/mad/3x/admin/dashboard';
    });
  </script>
</body>
</html>
