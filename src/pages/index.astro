---
import '../styles/global.css';

const photos = [
  { seed: 'madm01', w: 600, h: 820 },
  { seed: 'madm02', w: 600, h: 440 },
  { seed: 'madm03', w: 600, h: 760 },
  { seed: 'madm04', w: 600, h: 900 },
  { seed: 'madm05', w: 600, h: 480 },
  { seed: 'madm06', w: 600, h: 700 },
  { seed: 'madm07', w: 600, h: 520 },
  { seed: 'madm08', w: 600, h: 860 },
  { seed: 'madm09', w: 600, h: 620 },
  { seed: 'madm10', w: 600, h: 780 },
  { seed: 'madm11', w: 600, h: 460 },
  { seed: 'madm12', w: 600, h: 840 },
  { seed: 'madm13', w: 600, h: 560 },
  { seed: 'madm14', w: 600, h: 720 },
  { seed: 'madm15', w: 600, h: 500 },
  { seed: 'madm16', w: 600, h: 800 },
  { seed: 'madm17', w: 600, h: 660 },
  { seed: 'madm18', w: 600, h: 420 },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MADM3X</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png" />
  <link rel="apple-touch-icon" href="/logo/logo-color.png" />
</head>
<body>
  <a href="/" class="site-logo" aria-label="MADM3X">
    <img src="/logo/logo-color.png" alt="MADM3X" />
  </a>

  <main class="gallery">
    {photos.map(({ seed, w, h }) => (
      <div class="photo-item">
        <img
          src={`https://picsum.photos/seed/${seed}/${w}/${h}`}
          alt=""
          loading="lazy"
          decoding="async"
          width={w}
          height={h}
        />
      </div>
    ))}
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const items = document.querySelectorAll<HTMLElement>('.photo-item');

    items.forEach((item, i) => {
      const img = item.querySelector<HTMLImageElement>('img');
      if (!img) return;

      // Zoom-out — image starts scaled up and shrinks to normal as it scrolls through
      gsap.fromTo(img,
        { scale: 1.4 },
        {
          scale: 1.0,
          ease: 'none',
          scrollTrigger: {
            trigger: item,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.5,
          },
        }
      );

      // Reveal — fade + rise on enter, staggered by column position
      gsap.to(item, {
        opacity: 1,
        y: 0,
        duration: 1.1,
        delay: (i % 3) * 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 94%',
          toggleActions: 'play none none none',
        },
      });
    });
  </script>
</body>
</html>
