---
import '../styles/global.css';
import { randomHomePhotos } from '../lib/galleries.ts';

// Dynamic random selection — up to 100 photos, spread across all published galleries.
// Uses whatever is available if fewer than 100 photos exist total.
const photos = await randomHomePhotos(100);

// Fall back to placeholder images while real galleries haven't been set up yet
const placeholders = [
  { seed: 'madm01', w: 600, h: 820 }, { seed: 'madm02', w: 600, h: 440 },
  { seed: 'madm03', w: 600, h: 760 }, { seed: 'madm04', w: 600, h: 900 },
  { seed: 'madm05', w: 600, h: 480 }, { seed: 'madm06', w: 600, h: 700 },
  { seed: 'madm07', w: 600, h: 520 }, { seed: 'madm08', w: 600, h: 860 },
  { seed: 'madm09', w: 600, h: 620 }, { seed: 'madm10', w: 600, h: 780 },
  { seed: 'madm11', w: 600, h: 460 }, { seed: 'madm12', w: 600, h: 840 },
  { seed: 'madm13', w: 600, h: 560 }, { seed: 'madm14', w: 600, h: 720 },
  { seed: 'madm15', w: 600, h: 500 }, { seed: 'madm16', w: 600, h: 800 },
  { seed: 'madm17', w: 600, h: 660 }, { seed: 'madm18', w: 600, h: 420 },
];

const displayPhotos = photos.length > 0
  ? photos
  : placeholders.map(p => ({ src: `https://picsum.photos/seed/${p.seed}/${p.w}/${p.h}`, meta: null, gallerySlug: null, galleryTitle: null }));

const metaLabels = [
  ['Camera',     'model'],
  ['Dimensions', 'dimensions'],
  ['F-Stop',     'fstop'],
  ['Exposure',   'exposure'],
  ['ISO',        'iso'],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MADM3X</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png" />
  <link rel="apple-touch-icon" href="/logo/logo-color.png" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DQ0N65L4P7"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DQ0N65L4P7');
  </script>
</head>
<body>
  <a href="/" class="site-logo" aria-label="MADM3X">
    <img src="/logo/logo-color.png" alt="MADM3X" />
  </a>

  <main class="gallery">
    {displayPhotos.map(({ src, meta, gallerySlug, galleryTitle }, i) => (
      <div class="photo-item" data-gallery={gallerySlug}>
        {gallerySlug ? (
          <a href={`/${gallerySlug}`} class="photo-gallery-link" title={galleryTitle ?? ''}>
            <img src={src} alt="" loading="lazy" decoding="async" />
          </a>
        ) : (
          <img src={src} alt="" loading="lazy" decoding="async" />
        )}
        {meta && (
          <div class="photo-overlay">
            <dl class="photo-meta">
              {metaLabels.map(([label, key]) => meta[key] && (
                <div class="meta-row">
                  <dt>{label}</dt>
                  <dd>{meta[key]}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    ))}
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const items = document.querySelectorAll('.photo-item');

    // On mobile/touch devices: show images flat, no scroll zoom or hover effects
    if (window.matchMedia('(max-width: 720px)').matches) {
      items.forEach(item => gsap.set(item, { opacity: 1, y: 0 }));
    } else {
      function getOriginX(item) {
        const { left, right } = item.getBoundingClientRect();
        const vw  = window.innerWidth;
        const col = vw / 4;
        if (left < col)       return 'left';
        if (right > vw - col) return 'right';
        return 'center';
      }

      items.forEach((item, i) => {
        const img = item.querySelector('img');
        if (!img) return;

        gsap.set(item, { transformOrigin: `${getOriginX(item)} center` });

        const scrollTween = gsap.fromTo(img,
          { scale: 1.4 },
          {
            scale: 1.0,
            ease: 'none',
            scrollTrigger: {
              trigger: item,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 1.2,
            },
          }
        );

        gsap.to(item, {
          opacity: 1,
          y: 0,
          duration: 1.1,
          delay: (i % 4) * 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top bottom',
            toggleActions: 'play none none none',
          },
        });

        const st = scrollTween.scrollTrigger;

        item.addEventListener('mouseenter', () => {
          st.disable(false);
          gsap.to(img,  { scale: 1.0,  duration: 0.45, ease: 'power2.out',   overwrite: 'auto' });
          gsap.to(item, { scale: 1.12, zIndex: 20, duration: 0.45, ease: 'power2.out', overwrite: 'auto' });
        });

        item.addEventListener('mouseleave', () => {
          gsap.to(item, { scale: 1.0, zIndex: 1, duration: 0.4, ease: 'power2.inOut', overwrite: 'auto' });
          st.enable();
        });
      });
    }
  </script>
</body>
</html>
