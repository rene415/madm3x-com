---
import '../styles/global.css';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
import exifr from 'exifr';

function formatExposure(val) {
  if (val >= 1) return `${val}s`;
  return `1/${Math.round(1 / val)}s`;
}

function formatFStop(val) {
  return `f/${Number.isInteger(val) ? val : val.toFixed(1)}`;
}

const EXIF_TAGS = [
  'Make', 'Model', 'FNumber', 'ExposureTime', 'ISO',
  'ExifImageWidth', 'ExifImageHeight', 'ImageWidth', 'ImageHeight',
];

const photosDir = join(process.cwd(), 'public/photos');
let photos = [];

try {
  const files = await readdir(photosDir);
  const images = files
    .filter(f => /\.(jpe?g|png|webp|heic|tiff?)$/i.test(f) && f !== 'metadata.json')
    .sort();

  // Use pre-extracted sidecar when available (fast); fall back to live exifr per-file
  let sidecar = {};
  try {
    sidecar = JSON.parse(await readFile(join(photosDir, 'metadata.json'), 'utf8'));
  } catch { /* no sidecar yet */ }

  photos = await Promise.all(images.map(async (file) => {
    let meta = sidecar[file] ?? null;

    if (!meta) {
      try {
        const raw = await exifr.parse(join(photosDir, file), EXIF_TAGS);
        if (raw) {
          const w = raw.ExifImageWidth ?? raw.ImageWidth ?? null;
          const h = raw.ExifImageHeight ?? raw.ImageHeight ?? null;
          meta = {
            dimensions: w && h ? `${w} × ${h}` : null,
            model:      [raw.Make, raw.Model].filter(Boolean).join(' ') || null,
            fstop:      raw.FNumber      != null ? formatFStop(raw.FNumber)         : null,
            exposure:   raw.ExposureTime != null ? formatExposure(raw.ExposureTime) : null,
            iso:        raw.ISO          != null ? String(raw.ISO)                  : null,
          };
        }
      } catch { /* no EXIF */ }
    }

    return { src: `/photos/${encodeURIComponent(file)}`, meta };
  }));
} catch { /* photos dir empty */ }

// Fall back to placeholders while real photos haven't been uploaded yet
const placeholders = [
  { seed: 'madm01', w: 600, h: 820 },
  { seed: 'madm02', w: 600, h: 440 },
  { seed: 'madm03', w: 600, h: 760 },
  { seed: 'madm04', w: 600, h: 900 },
  { seed: 'madm05', w: 600, h: 480 },
  { seed: 'madm06', w: 600, h: 700 },
  { seed: 'madm07', w: 600, h: 520 },
  { seed: 'madm08', w: 600, h: 860 },
  { seed: 'madm09', w: 600, h: 620 },
  { seed: 'madm10', w: 600, h: 780 },
  { seed: 'madm11', w: 600, h: 460 },
  { seed: 'madm12', w: 600, h: 840 },
  { seed: 'madm13', w: 600, h: 560 },
  { seed: 'madm14', w: 600, h: 720 },
  { seed: 'madm15', w: 600, h: 500 },
  { seed: 'madm16', w: 600, h: 800 },
  { seed: 'madm17', w: 600, h: 660 },
  { seed: 'madm18', w: 600, h: 420 },
];

const displayPhotos = photos.length > 0
  ? photos
  : placeholders.map(p => ({ src: `https://picsum.photos/seed/${p.seed}/${p.w}/${p.h}`, meta: null }));

const metaLabels = [
  ['Camera',     'model'],
  ['Dimensions', 'dimensions'],
  ['F-Stop',     'fstop'],
  ['Exposure',   'exposure'],
  ['ISO',        'iso'],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MADM3X</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png" />
  <link rel="apple-touch-icon" href="/logo/logo-color.png" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DQ0N65L4P7"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DQ0N65L4P7');
  </script>
</head>
<body>
  <a href="/" class="site-logo" aria-label="MADM3X">
    <img src="/logo/logo-color.png" alt="MADM3X" />
  </a>

  <main class="gallery">
    {displayPhotos.map(({ src, meta }, i) => (
      <div class="photo-item">
        <img
          src={src}
          alt=""
          loading="lazy"
          decoding="async"
        />
        {meta && (
          <div class="photo-overlay">
            <dl class="photo-meta">
              {metaLabels.map(([label, key]) => meta[key] && (
                <div class="meta-row">
                  <dt>{label}</dt>
                  <dd>{meta[key]}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    ))}
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const items = document.querySelectorAll('.photo-item');

    // Detect which horizontal edge each item sits near so the hover
    // scale expands inward (away from the page edge) instead of clipping.
    function getOriginX(item) {
      const { left, right } = item.getBoundingClientRect();
      const vw = window.innerWidth;
      const col = vw / 4; // approximate column width
      if (left < col * 0.75)        return 'left';
      if (right > vw - col * 0.75)  return 'right';
      return 'center';
    }

    items.forEach((item, i) => {
      const img = item.querySelector('img');
      if (!img) return;

      const originX = getOriginX(item);

      // Item hover scale expands away from the nearest page edge
      gsap.set(item, { transformOrigin: `${originX} center` });
      // Image scroll zoom always pivots from image center (shows middle of photo)
      gsap.set(img,  { transformOrigin: 'center center' });

      // Scroll-driven zoom-out — resolves to full image by the time
      // the item reaches viewport center (so bottom items are never stuck zoomed)
      const scrollTween = gsap.fromTo(img,
        { scale: 1.35 },
        {
          scale: 1.0,
          ease: 'none',
          scrollTrigger: {
            trigger: item,
            start: 'top bottom',
            end: 'center center',
            scrub: 0.8,
          },
        }
      );

      // Reveal — fires as soon as any part of the item enters the viewport
      gsap.to(item, {
        opacity: 1,
        y: 0,
        duration: 1.1,
        delay: (i % 4) * 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top bottom',
          toggleActions: 'play none none none',
        },
      });

      const st = scrollTween.scrollTrigger;

      // Hover — pause scroll zoom, show full image, pop card forward
      item.addEventListener('mouseenter', () => {
        st.disable(false);
        gsap.to(img,  { scale: 1.0,  duration: 0.45, ease: 'power2.out',   overwrite: 'auto' });
        gsap.to(item, { scale: 1.12, zIndex: 20, duration: 0.45, ease: 'power2.out', overwrite: 'auto' });
      });

      item.addEventListener('mouseleave', () => {
        gsap.to(item, { scale: 1.0, zIndex: 1, duration: 0.4, ease: 'power2.inOut', overwrite: 'auto' });
        st.enable();
      });
    });
  </script>
</body>
</html>
