---
import '../styles/global.css';
import { getGallery, listPhotos, getMetadata, photoUrl } from '../lib/galleries.ts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const gallery = await getGallery(slug);

// 404 if gallery doesn't exist or isn't published — return a real HTML page
if (!gallery || !gallery.published) {
  const isDraft = gallery && !gallery.published;
  const html = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>MADM3X</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{background:#080808;color:#e8e8e8;font-family:'Courier New',monospace;
      min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px}
    img{width:56px;opacity:.7}
    p{font-size:.7rem;text-transform:uppercase;letter-spacing:.18em;color:rgba(255,255,255,.35);text-align:center}
    a{font-size:.65rem;text-transform:uppercase;letter-spacing:.15em;color:rgba(255,255,255,.4);
      text-decoration:underline;text-underline-offset:4px}
    a:hover{color:rgba(255,255,255,.7)}
  </style>
</head>
<body>
  <img src="/logo/logo-color.png" alt="MADM3X">
  <p>${isDraft ? 'This gallery isn\'t public yet.' : 'Gallery not found.'}</p>
  <a href="/">← Back to home</a>
</body>
</html>`;
  return new Response(html, {
    status: isDraft ? 404 : 404,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

const photos   = await listPhotos(slug);
const metadata = await getMetadata(slug);

const displayPhotos = photos.map(filename => ({
  src:  photoUrl(slug, filename),
  meta: metadata[filename] ?? null,
}));

const metaLabels = [
  ['Camera',     'model'],
  ['Dimensions', 'dimensions'],
  ['F-Stop',     'fstop'],
  ['Exposure',   'exposure'],
  ['ISO',        'iso'],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MADM3X · {gallery.title}</title>
  <link rel="icon" type="image/png" href="/logo/logo-bw.png" />
  <link rel="apple-touch-icon" href="/logo/logo-color.png" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DQ0N65L4P7"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DQ0N65L4P7');
  </script>
</head>
<body>
  <a href="/" class="site-logo" aria-label="MADM3X">
    <img src="/logo/logo-color.png" alt="MADM3X" />
  </a>

  <main class="gallery">
    {displayPhotos.map(({ src, meta }, i) => (
      <div class="photo-item">
        <img src={src} alt="" loading="lazy" decoding="async" />
        {meta && (
          <div class="photo-overlay">
            <dl class="photo-meta">
              {metaLabels.map(([label, key]) => meta[key] && (
                <div class="meta-row">
                  <dt>{label}</dt>
                  <dd>{meta[key]}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    ))}
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const items = document.querySelectorAll('.photo-item');

    if (window.matchMedia('(max-width: 720px)').matches) {
      items.forEach(item => gsap.set(item, { opacity: 1, y: 0 }));
    } else {
      function getOriginX(item) {
        const { left, right } = item.getBoundingClientRect();
        const vw  = window.innerWidth;
        const col = vw / 4;
        if (left < col)       return 'left';
        if (right > vw - col) return 'right';
        return 'center';
      }

      items.forEach((item, i) => {
        const img = item.querySelector('img');
        if (!img) return;

        gsap.set(item, { transformOrigin: `${getOriginX(item)} center` });

        const scrollTween = gsap.fromTo(img,
          { scale: 1.4 },
          {
            scale: 1.0,
            ease: 'none',
            scrollTrigger: {
              trigger: item,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 1.2,
            },
          }
        );

        gsap.to(item, {
          opacity: 1,
          y: 0,
          duration: 1.1,
          delay: (i % 4) * 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top bottom',
            toggleActions: 'play none none none',
          },
        });

        const st = scrollTween.scrollTrigger;

        item.addEventListener('mouseenter', () => {
          st.disable(false);
          gsap.to(img,  { scale: 1.0,  duration: 0.45, ease: 'power2.out',   overwrite: 'auto' });
          gsap.to(item, { scale: 1.12, zIndex: 20, duration: 0.45, ease: 'power2.out', overwrite: 'auto' });
        });

        item.addEventListener('mouseleave', () => {
          gsap.to(item, { scale: 1.0, zIndex: 1, duration: 0.4, ease: 'power2.inOut', overwrite: 'auto' });
          st.enable();
        });
      });
    }
  </script>
</body>
</html>
