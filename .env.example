# Admin login credentials
# Generate these with: node scripts/setup-admin.mjs
ADMIN_EMAIL=rene@reneramirez.me
ADMIN_PASSWORD_HASH=

# Random 64-char hex string — generated by setup-admin.mjs
JWT_SECRET=

# Path inside the Docker container where gallery data is stored
# (matches the volume mount in docker-compose.yml — don't change this)
DATA_DIR=/app/data
